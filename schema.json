{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CampusMoveAIChatResponse",
  "type": "object",
  "required": [
    "answer",
    "intent",
    "explanation",
    "next_action",
    "suggested_departure",
    "confidence"
  ],
  "properties": {
    "answer": {
      "type": "string",
      "description": "Most relevant response to the user's question in plain language."
    },
    "intent": {
      "type": "string",
      "enum": ["route_planning", "delay_handling", "general"],
      "description": "Classified intent for this user question."
    },
    "explanation": {
      "type": "string",
      "description": "Why this answer/recommendation was selected."
    },
    "next_action": {
      "type": "string",
      "description": "Concrete next step the user should take."
    },
    "suggested_departure": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "description": "Suggested departure time in 24-hour HH:MM."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score in the answer."
    }
  },
  "additionalProperties": false
}